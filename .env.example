DATABASE_URL=sqlite:///./attendance.db
STORAGE_DIR=./storage
CAMERA_API_TOKEN=change-me-camera-token
AUTH_SESSION_HOURS=8
ATTENDANCE_THRESHOLD=0.65
ATTENDANCE_MARGIN=0.05
ATTENDANCE_MIN_HITS=3
ATTENDANCE_WINDOW_SECONDS=4
FACE_DISTANCE_THRESHOLD=0.52
FACE_DISTANCE_MARGIN=0.04
ENROLLMENT_NUM_JITTERS=3
# Independent multi-face attendance confirmation, including slower CPU streams.
STREAM_MAX_FACES_PER_FRAME=8
STREAM_CONFIRMATION_WINDOW_SECONDS=30
STREAM_MIN_OBSERVATION_INTERVAL_SECONDS=0.25
STREAM_MIN_CONFIRMATION_SECONDS=0.5
STREAM_MAX_OBSERVATION_GAP_SECONDS=10
# YuNet hỗ trợ HOG khi quay đầu; chạy script tải detector trước khi bật hybrid.
# yunet ưu tiên DNN, chỉ chạy HOG khi DNN không thấy mặt; cần đánh giá trên camera thực.
FACE_DETECTION_BACKEND=hog
FACE_DETECTION_MODEL_PATH=./storage/face-models/face_detection_yunet_2023mar.onnx
FACE_DETECTION_SCORE_THRESHOLD=0.90
FACE_DETECTION_MAX_SIDE=640
# off preserves legacy behavior; shadow measures only; enforce changes decisions.
PREPROCESSING_MODE=off
PREPROCESSING_ALIGN_EYES=true
PREPROCESSING_NORMALIZE_LIGHTING=true
PREPROCESSING_SEARCH_ROTATIONS=true
PREPROCESSING_SEARCH_ROLLS=true
# Enable only for a source known to send mirrored pixels (CSS preview does not).
PREPROCESSING_MIRROR_INPUT=false
PREPROCESSING_MAX_ROLL_DEGREES=40
# Preserve v1 templates. Use v2 + enforce only after benchmark and re-enrollment.
PREPROCESSING_VERSION=v1
# On enforced v1, v2 is evaluated on 10% of frames without affecting attendance.
PREPROCESSING_SHADOW_V2=true
PREPROCESSING_SHADOW_SAMPLE_RATE=0.1
# v2: dlib keeps its own face-chip alignment; external alignment is an ablation.
PREPROCESSING_V2_ALIGN_EYES=false
PREPROCESSING_LIGHTING_METHOD=adaptive
PREPROCESSING_DENOISE_METHOD=off
PREPROCESSING_ROI_PADDING=0.25
PREPROCESSING_GAMMA_MIN=0.65
PREPROCESSING_GAMMA_MAX=1.4
PREPROCESSING_CLAHE_CLIP_LIMIT=1.5
PREPROCESSING_MAX_DETECTION_ATTEMPTS=8
